# Machine-local path inventory; this template intentionally has no paths.
# Read it before searching the host; record supplied/discovered paths here
# immediately (see AGENTS.md "Local path inventory"). Never commit .local.env.
#
# Every key a script reads is listed here, with its valid values.
# scripts/test_env_inventory.py fails when a script reads a key that is not
# listed, so an option cannot be added without its documentation.
#
# Format: one KEY="value" per line, shell-quoted. An empty value is "not
# set", which is what every key below means by default. A leading `export `
# is accepted, and a key written twice takes its last value, so the shell and
# Python readers answer identically.

# --- paths -----------------------------------------------------------------

# Client game-install root (required to build C#; read-only reference).
# Absolute path to the install holding Data/Config/items.xml.
SEVEN_DAYS_TO_DIE_DIR=""

# Optional Linux dedicated-server install, provisioned with SteamCMD.
# Absolute, and at least two levels deep (/srv/7dtd-server, not /srv).
SEVEN_DAYS_TO_DIE_SERVER_DIR=""

# Directory holding the hordeforge tool checkouts, and per-repo overrides.
# See docs/reference/sibling-tooling.md.
HORDEFORGE_ROOT=""
PLAYTEST_ROOT=""
CONNECT_ROOT=""
ASSET_PIPELINE_ROOT=""

# Toolchain locations, when not on PATH.
DOTNET_ROOT=""
# Absolute path to the ilspycmd executable, when it is neither on PATH nor in
# ~/.dotnet/tools. Searched in that order; a path that is not a file is
# reported rather than silently replaced.
ILSPYCMD=""

# FULLY optional; leave empty. Path to the game-matched Unity editor
# EXECUTABLE (.../Hub/Editor/<game version>/Editor/Unity), used only when
# opting into shamway's bundle_source="unity" lane — the default
# synthesized lane builds complete bundles (textures, audio, text, meshes,
# materials, prefabs) with no editor at all. Must match the game's Unity
# version when set.
UNITY_EDITOR=""

# Directory holding the Proton user's Saves/, read by
# `make verify-patched-config`. Leave empty to derive it from
# SEVEN_DAYS_TO_DIE_DIR, which only works for a Steam-managed install.
SEVEN_DAYS_TO_DIE_SAVES_DIR=""

# --- dedicated-server lane --------------------------------------------------
# None of these are needed by the client-side targets; leave them empty.

# serverconfig the server lane deploys against. Must be absolute.
# Defaults to <SEVEN_DAYS_TO_DIE_SERVER_DIR>/serverconfig.__MOD_NAME_LOWER__.xml.
SEVEN_DAYS_TO_DIE_SERVER_CONFIG=""

# SteamCMD to provision the server with. Empty: a steamcmd on PATH wins, then
# <SEVEN_DAYS_TO_DIE_STEAMCMD_DIR>/steamcmd.sh, then
# ~/.local/share/steamcmd/steamcmd.sh. A value that is not executable is
# skipped, and the next tier is tried.
SEVEN_DAYS_TO_DIE_STEAMCMD=""

# Directory holding steamcmd.sh, when it is neither on PATH nor given whole.
# Unset: ~/.local/share/steamcmd.
SEVEN_DAYS_TO_DIE_STEAMCMD_DIR=""

# Steam AppID of the dedicated server. Positive decimal integer; a leading
# zero is read as the number it spells, not as octal. Default 294420.
SEVEN_DAYS_TO_DIE_SERVER_APP_ID=""

# How long `make server-smoke` boots the server before stopping it.
# Positive decimal integer seconds; a leading zero is read as the number it
# spells, not as octal. Default 90.
SEVEN_DAYS_TO_DIE_SERVER_RUN_SECONDS=""

# How many smoke logs `make server-smoke` keeps; 0 keeps none. Non-negative
# decimal integer, leading zeros allowed. Default 5.
SEVEN_DAYS_TO_DIE_SERVER_KEEP_LOGS=""

# --- tests, packaging -------------------------------------------------------

# Suite id for `make playtest`; a Makefile variable, so `make playtest SUITE=x`
# also works. PLAYTEST_SUITE is the same knob read straight from the
# environment, and PLAYTEST_SUITE_FILE overrides the suites/<id>.json lookup.
SUITE=""
PLAYTEST_SUITE=""
PLAYTEST_SUITE_FILE=""

# Parallelism of `make test`. Positive integer; empty or invalid means one job
# per core, capped at 8.
OFFLINE_TEST_JOBS=""

# Set to 1 to append per-test seconds to the `make test` report. 0 or empty
# keeps the report byte-identical between runs, which the gates depend on.
OFFLINE_TEST_TIMINGS=""

# Timestamp for every file in `make package`'s zip. Positive integer seconds
# since the epoch, in the range 315532800 (1980-01-01T00:00:00Z) through
# 4354819198 (2107-12-31T23:59:58Z), which is what a zip entry's 32-bit DOS
# date can hold; a value outside it is rejected, because Info-ZIP wraps it
# silently and stamps the archive with a date nobody asked for. Empty: the
# last commit's timestamp, else a fixed constant.
SOURCE_DATE_EPOCH=""
