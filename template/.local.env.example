# Machine-local path inventory; this template intentionally has no paths.
# Read it before searching the host; record supplied/discovered paths here
# immediately (see AGENTS.md "Local path inventory"). Never commit .local.env.

# Client game-install root (required to build C#; read-only reference).
SEVEN_DAYS_TO_DIE_DIR=""

# Optional Linux dedicated-server install, provisioned with SteamCMD.
SEVEN_DAYS_TO_DIE_SERVER_DIR=""

# Directory holding the hordeforge tool checkouts, and per-repo overrides.
# See docs/reference/sibling-tooling.md.
HORDEFORGE_ROOT=""
PLAYTEST_ROOT=""
CONNECT_ROOT=""
ASSET_PIPELINE_ROOT=""

# Toolchain locations, when not on PATH.
DOTNET_ROOT=""
ILSPYCMD=""

# FULLY optional; leave empty. Path to the game-matched Unity editor
# EXECUTABLE (.../Hub/Editor/<game version>/Editor/Unity), used only when
# opting into shamway's bundle_source="unity" lane — the default
# synthesized lane builds complete bundles (textures, audio, text, meshes,
# materials, prefabs) with no editor at all. Must match the game's Unity
# version when set.
UNITY_EDITOR=""
