# Machine-specific local reference; this template intentionally has no path.
# An agent creates .local.env only after the user supplies the absolute game
# install directory. Never commit .local.env.
SEVEN_DAYS_TO_DIE_DIR=""

# Optional Linux dedicated-server install, provisioned with SteamCMD.
SEVEN_DAYS_TO_DIE_SERVER_DIR=""

# Optional Unity editor executable, only needed to build custom asset
# bundles; must match the game's Unity version (see docs/reference/).
UNITY_EDITOR=""

# Directory holding the hordeforge tool checkouts (7dtd-playtest,
# 7dtd-asset-pipeline, ...). See docs/reference/sibling-tooling.md.
HORDEFORGE_ROOT=""
