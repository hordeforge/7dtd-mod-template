# Anvil scaffold config — shell key=value. Copy, fill in, then:
#   ./new-mod.sh myconfig.conf
# Any config filename works (nothing is hardcoded); keep one-off configs
# out of git via the *.local.conf ignore pattern, or commit reusable
# presets. Missing required keys are prompted for interactively.
# An unknown key here is an error, and so is a yes/no key holding anything
# other than "yes" or "no": a typo would otherwise scaffold a mod that is
# quietly missing the feature the key asks for.

# Required
name=""              # modlet id: alphanumeric, becomes the directory and ModInfo Name
author=""
purpose=""           # what the mod is for — a sentence or paragraph; seeded into README/design/TODO.
                     # Its first sentence, capped at 200 characters and cut at the
                     # sentence end its script writes, becomes ModInfo.xml's Description.
target_dir=""        # the mod directory is created at <target_dir>/<name>

# Optional
display_name=""      # defaults to name
csharp="no"          # yes: include the net48 Harmony DLL project (sets SkipWithAntiCheat)
assets="no"          # yes: include assets-src/ and the shamway Makefile targets
clone="yes"          # no: skip cloning missing hordeforge tool repos
hordeforge_root=""   # directory holding the hordeforge tool checkouts; prompted if empty
game_dir=""          # 7DTD client install; auto-detected from the default Steam path
server_dir=""        # optional dedicated-server install
unity_editor=""      # FULLY optional; leave empty. Path to the game-matched Unity
                     # editor EXECUTABLE (.../Hub/Editor/<version>/Editor/Unity),
                     # used only if you opt into shamway's bundle_source="unity"
                     # lane — its default synthesized lane builds complete bundles
                     # (textures, audio, text, meshes, materials, prefabs) with
                     # no editor at all

# Every path above accepts "~" as your home directory and is expanded before
# it is written into the new mod's .local.env.
